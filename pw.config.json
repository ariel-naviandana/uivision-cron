  "schedule": "*/15 * * * *",
  "runOnStart": true,
  "restartBrowser": true,
  "restartWaitMs": 3000,
  "browser": {
    "chromePath": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "userDataDir": "C:\\chrome-profiles\\fomo-playwright",
    "headless": false,
    "blockResources": false,
    "viewport": {
      "width": 1600,
      "height": 1000
    }
  },
  "profileName": "VagueCoralJay",
  "startTokenUrl": "https://fomo.family/tokens/solana/3NZ9JMVBmGAqocybic2c7LQCJScmgsAZ6vQqTDzcqmJh",
  "dryRunSell": true,
  "dryRunAd": true,
  "tp": 20,
  "tpCustom": {},
  "exclude": [],
  "adTrigger": -25,
  "adMinAgeH": 6,
  "adUseRsi": true,
  "adRsiMax": 30,
  "adMinOrderUsd": 0,
  "adBelowMin": "skip",
